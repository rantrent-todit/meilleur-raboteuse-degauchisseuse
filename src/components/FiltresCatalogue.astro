---
interface CategoryItem {
  name: string;
  slug: string;
  count: number;
}

interface Props {
  categories: CategoryItem[];
  totalCount: number;
}

const { categories = [], totalCount = 0 } = Astro.props;
---

<div class="bg-white border border-slate-200/90 rounded-2xl p-5 mb-8 shadow-xs scroll-mt-28" id="catalogue-filtres">
  <div class="flex flex-col md:flex-row gap-4 items-stretch md:items-center justify-between">
    <!-- Barre de Recherche Instantanée -->
    <div class="relative flex-1 max-w-md">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <input 
        type="search" 
        id="catalog-search-input" 
        placeholder="Rechercher un modèle, marque, usage..." 
        class="w-full pl-10 pr-4 py-2.5 text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 transition-all placeholder:text-slate-400"
      />
    </div>

    <!-- Tri & Compteur -->
    <div class="flex items-center justify-between sm:justify-end gap-4">
      <span class="text-xs font-bold text-slate-500 whitespace-nowrap" id="catalog-count-label">
        <strong class="text-slate-900" id="catalog-count-number">{totalCount}</strong> modèles affichés
      </span>

      <div class="flex items-center gap-1.5">
        <label for="catalog-sort-select" class="text-[11px] font-bold text-slate-500 uppercase tracking-wider hidden sm:inline">Tri :</label>
        <select 
          id="catalog-sort-select" 
          class="text-xs font-bold bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-700 focus:outline-none focus:border-orange-500 cursor-pointer"
        >
          <option value="featured">Recommandations</option>
          <option value="alpha">Nom (A-Z)</option>
          <option value="alpha-desc">Nom (Z-A)</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Pilules Catégories avec scroll horizontal -->
  <div class="mt-4 pt-4 border-t border-slate-100 flex items-center gap-2 overflow-x-auto pb-1 text-xs no-scrollbar" id="catalog-category-pills">
    <button 
      type="button" 
      class="cat-pill px-3.5 py-1.5 rounded-lg font-bold whitespace-nowrap bg-slate-900 text-white transition-all cursor-pointer" 
      data-filter-cat="all"
    >
      Tous ({totalCount})
    </button>
    {categories.map(c => (
      <button 
        type="button" 
        class="cat-pill px-3 py-1.5 rounded-lg font-bold whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors cursor-pointer" 
        data-filter-cat={c.slug}
      >
        {c.name} {c.count > 0 && <span class="opacity-60 text-[10px]">({c.count})</span>}
      </button>
    ))}
  </div>
</div>

<!-- État vide si aucune correspondance -->
<div id="catalog-empty-state" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 my-8">
  <div class="w-12 h-12 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center mx-auto mb-3">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  </div>
  <h3 class="text-base font-black text-slate-900 mb-1">Aucun modèle ne correspond à votre recherche</h3>
  <p class="text-xs text-slate-500 mb-4">Essayez d'autres mots-clés ou réinitialisez les critères de filtrage.</p>
  <button 
    type="button" 
    id="catalog-reset-btn" 
    class="px-5 py-2.5 bg-slate-900 text-white rounded-xl text-xs font-bold hover:bg-slate-800 transition-colors cursor-pointer"
  >
    Réinitialiser les filtres
  </button>
</div>

<script is:inline>
  (function() {
    const searchInput = document.getElementById('catalog-search-input');
    const sortSelect = document.getElementById('catalog-sort-select');
    const pills = document.querySelectorAll('.cat-pill');
    const countNumber = document.getElementById('catalog-count-number');
    const emptyState = document.getElementById('catalog-empty-state');
    const resetBtn = document.getElementById('catalog-reset-btn');
    const productCards = document.querySelectorAll('[data-product-card]');
    const container = document.getElementById('products-grid-container');

    let activeCategory = 'all';
    let searchQuery = '';

    function normalizeStr(str) {
      return (str || '')
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();
    }

    function applyFilters() {
      let visibleCount = 0;
      const cardsArr = Array.from(productCards);

      cardsArr.forEach(card => {
        const title = normalizeStr(card.dataset.title);
        const desc = normalizeStr(card.dataset.desc);
        const cats = normalizeStr(card.dataset.cats);
        const slugs = (card.dataset.catSlugs || '').split(',');

        const matchesQuery = !searchQuery || 
          title.includes(searchQuery) || 
          desc.includes(searchQuery) || 
          cats.includes(searchQuery);

        const matchesCat = activeCategory === 'all' || slugs.includes(activeCategory);

        if (matchesQuery && matchesCat) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countNumber) countNumber.textContent = visibleCount;
      if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0);
      if (container) container.classList.toggle('hidden', visibleCount === 0);
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = normalizeStr(e.target.value);
        applyFilters();
      });
    }

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => {
          p.className = 'cat-pill px-3 py-1.5 rounded-lg font-bold whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors cursor-pointer';
        });
        pill.className = 'cat-pill px-3.5 py-1.5 rounded-lg font-bold whitespace-nowrap bg-slate-900 text-white transition-all cursor-pointer';
        activeCategory = pill.dataset.filterCat || 'all';
        applyFilters();
      });
    });

    if (sortSelect && container) {
      sortSelect.addEventListener('change', () => {
        const sortVal = sortSelect.value;
        const cards = Array.from(productCards);
        if (sortVal === 'alpha') {
          cards.sort((a, b) => (a.dataset.title || '').localeCompare(b.dataset.title || ''));
        } else if (sortVal === 'alpha-desc') {
          cards.sort((a, b) => (b.dataset.title || '').localeCompare(a.dataset.title || ''));
        } else {
          cards.sort((a, b) => parseInt(a.dataset.index || '0') - parseInt(b.dataset.index || '0'));
        }
        cards.forEach(c => container.appendChild(c));
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        activeCategory = 'all';
        pills.forEach(p => {
          p.className = p.dataset.filterCat === 'all' 
            ? 'cat-pill px-3.5 py-1.5 rounded-lg font-bold whitespace-nowrap bg-slate-900 text-white transition-all cursor-pointer'
            : 'cat-pill px-3 py-1.5 rounded-lg font-bold whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors cursor-pointer';
        });
        applyFilters();
      });
    }

    // Gestion du scroll automatique si ancre présente
    if (window.location.hash === '#catalogue-filtres' && searchInput) {
      setTimeout(() => {
        searchInput.focus();
      }, 300);
    }
  })();
</script>
